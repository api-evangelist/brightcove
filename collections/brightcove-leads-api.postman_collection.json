      "name": "Leads",
      "description": {
        "content": "Get leads for a Video Cloud account.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "dd624a05-43e4-40c3-9c4b-39959e25620c",
          "name": "Get Leads",
          "request": {
            "name": "Get Leads",
            "description": {
              "content": "Get leads for an account",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":account_id",
                "leads"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "25",
                  "description": "Number of items to return"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Number of items to skip"
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "created_at",
                  "description": "Field to sort lead results by (prefix with `-` for descending order)"
                },
                {
                  "disabled": false,
                  "key": "fields",
                  "value": "<string>",
                  "description": "Fields to return for leads\n\n**Note:** by default, all fields are returned. Use this parameter to return fewer fields."
                },
                {
                  "disabled": false,
                  "key": "where",
                  "value": "<string>",
                  "description": "One or more field==value pairs to filter the results; fields supported are `video_id`, `video_name`, `tracking_id`, `external_id`, `player_id`, `page_url`, `watched`, `time_watched`, `created_at`, `updated_at`, `is_synced`"
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<string>",
                  "description": "'Start time for the period covered by the report — epoch time in milliseconds or a date in the format `yyyy-mm-dd` (such as `2013-09-26`) or a relative date in `d` (days), `h` (hours), `m` (minutes), `s` (seconds) (such as `-2d` or `-6h`)'"
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<string>",
                  "description": "End time for the period covered by the report — epoch time in milliseconds or a date in the format `yyyy-mm-dd` (such as `2013-09-26`) or a relative date in `d` (days), `h` (hours), `m` (minutes), `s` (seconds) (such as `-2d` or `-6h`)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<number>",
                  "key": "account_id",
                  "description": "(Required) a Video Cloud account ID"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "video-cloud/analytics/read video-cloud/video/read"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://oauth.brightcove.com/v4/access_token"
                },
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            }
          },
