    {
      "id": "cc6e8cf6-6336-42f4-80e2-ac48dc358bb7",
      "name": "History",
      "description": {
        "content": "Operations for getting the history of all or a specific video.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "aa5212dd-656d-440a-bb35-5a0eaae6904c",
          "name": "List the lifetime social history for every video on the account.",
          "request": {
            "name": "List the lifetime social history for every video on the account.",
            "description": {
              "content": "Gets the lifetime history of every video Social has ever attempted to distribute to a social platform.  Note that this endpoint has pagination.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "accounts",
                ":account_id",
                "videos",
                "history"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "platform",
                  "value": "<string>",
                  "description": "Limit the list of videos to a single social platform.  Valid values for this property are\n- YOUTUBE\n- FACEBOOK\n- TWITTER\n\nNote that this may conflict with `destination_id`, below."
                },
                {
                  "disabled": false,
                  "key": "destination_id",
                  "value": "<uuid>",
                  "description": "Limit the list of videos to a single Social destination, by it's ID. Note that this may conflict with `platform`, above. (e.g., Specifying `platform=YOUTUBE` and passing the ID of a Twitter destination will result in no statuses.)  Generally if you are passing a `destination_id` you probably don't want to be passing a `platform` as well, as destinations imply a platform.\n"
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Limit the list of videos to those with a specific status.  Valid values for this property are\n  - DELETED\n  - ERROR\n  - HIDDEN\n  - PROCESSING\n  - PUBLISHED\n  - SCHEDULED\n  - SYNCED\n  - ABANDONED"
                },
                {
                  "disabled": false,
                  "key": "before",
                  "value": "<dateTime>",
                  "description": "Limit the list of videos to those whose last status change occurred before the specified date time.  Can accept either a full timestamp, or just a datestamp.  If passed just a datestamp, assumes 00:00:00 for the time, and the filter will be exclusive of the date specified."
                },
                {
                  "disabled": false,
                  "key": "since",
                  "value": "<dateTime>",
                  "description": "Limit the list of videos to those whose last status change occurred since the specified date time.  Can accept either a full timestamp, or just a datestamp.  If passed just a datestamp, assumes 00:00:00 for the time, and the filter will be inclusive of the date specified."
                },
                {
                  "disabled": false,
                  "key": "page_key",
                  "value": "<string>",
                  "description": "Fetch the next page of data.  If the previous call to this endpoint returned a `page_key`, a subsequent call can be made with the same parameters and including the `page_key` to retrieve the next page."
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "<integer>",
                  "description": "The number of entries to fetch in the next page of data.  Must be a number between 1 and 100, inclusive.  Defaults to 20."
                },
                {
                  "disabled": false,
                  "key": "pretty_print",
                  "value": "<boolean>",
                  "description": "Whether or not to pretty-print the JSON response.  Defaults to false."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "account_id",
                  "description": "(Required) ID of the account to query video statuses for"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "video-cloud/analytics/read video-cloud/video/read"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://oauth.brightcove.com/v4/access_token"
                },
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            }
          },
