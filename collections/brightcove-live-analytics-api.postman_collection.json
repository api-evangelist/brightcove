{
  "item": [
    {
      "id": "5fbbdd24-fd0f-4c7a-9e0d-d57882faa6bb",
      "name": "Live Analytics",
      "description": {
        "content": "Analytics for Live streams",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "c17fad4d-1bb4-4cd3-b55a-ef1d221a79ad",
          "name": "Get Live Analytics time-series",
          "request": {
            "name": "Get Live Analytics time-series",
            "description": {
              "content": "A time-series is defined as a an list of timestamp-value pairs representing samples of a variable (metric). The time-series API intends to allow the user to return a time-series for the set of metrics requested in the query.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "timeseries",
                "accounts",
                ":account_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "dimensions",
                  "value": "<string>",
                  "description": "(Required) One or more dimensions to report on for Live Analytics requests\nDimensions:\n  - video\n  - video, country\n  - video, device_type"
                },
                {
                  "disabled": false,
                  "key": "bucket_limit",
                  "value": "<integer>",
                  "description": "'Max number of points to be returned for a time-series'"
                },
                {
                  "disabled": false,
                  "key": "bucket_duration",
                  "value": "<string>",
                  "description": "'Intervals duration in the form of an integer plus `m` (minutes), `h` (hours), or `d` (days)'"
                },
                {
                  "disabled": false,
                  "key": "metrics",
                  "value": "<string>",
                  "description": "(Required) Data metrics to return for live analytics requests:\n\n  - `video_impression` - the number of video impressions\n  - `video_view` - the number of video views\n  - `video_seconds_viewed` - seconds of video viewed\n  - `alive_ss_ad_start` - SSAI ad starts\n  - `fingerprint_count` - \"fingerprint\" (user) count\n  - `ccu` - concurrent viewers"
                },
                {
                  "disabled": false,
                  "key": "where",
                  "value": "<string>",
                  "description": "(Required) one or more 'dimension==value' pairs to filter the results; for live, the only available filters are `country`, `device-type`, and `video`. This is a filter in which the options areL where in the world, in which device or which part of the video. In this case, the property is called where as if to use some DSL that mimics the SQL syntax, and that is why it is called where"
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<string>",
                  "description": "'Start time for the period covered by the report — epoch time in milliseconds (`1535654206775`) or a date in the format `yyyy-mm-dd` (such as `2013-09-26`)'"
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<string>",
                  "description": "End time for the period covered by the report — `now` or epoch time in milliseconds (`1535654206775`) or a date in the format `yyyy-mm-dd` (such as `2013-09-26`)"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "account_id",
                  "description": "(Required) a Video Cloud account ID"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Accept-Encoding: gzip (optional)",
                "key": "Accept-Encoding",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "video-cloud/analytics/read video-cloud/video/read"
                },
                {
                  "key": "accessTokenUrl",
                  "value": "https://oauth.brightcove.com/v4/access_token"
                },
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
