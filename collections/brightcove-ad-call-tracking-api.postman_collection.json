                "accounts",
                ":account_id",
                "ssai_debug_vmap",
                "debug.xml"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
